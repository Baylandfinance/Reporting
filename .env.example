# Copy to .env.local for local dev. In Vercel, set these as Environment
# Variables in the project settings — never commit real values.

# --- Supabase (create the project in the Sydney / ap-southeast-2 region) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Microsoft Graph (Entra ID app registration in your 365 tenant) ---
# Scopes required: offline_access, Files.Read.All (delegated) — do not grant
# Files.ReadWrite or Sites.* unless a later feature needs it.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=http://localhost:3000/api/graph/callback

# 32-byte (base64) key used to encrypt Graph refresh tokens at rest before
# they are stored in Supabase. Generate with:
#   openssl rand -base64 32
GRAPH_TOKEN_ENCRYPTION_KEY=
